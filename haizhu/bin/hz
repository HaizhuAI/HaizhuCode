#!/bin/sh
# hz — HaizhuCode 管理 CLI
# 用法: hz <verb> [args]
#   seed [HOME...]   把 HaizhuCode 负载注入指定 HOME（默认全部已知 home）
#   status           显示负载与各 agent 配置接线状态
#   kernel           打印内核文件路径（可接 > 或 |）
#   agents|skills    列出角色/技能
#   mcp <verb>       list|install <id>|sync|run <id>|doctor
#   phone <url> [tok] 配对 Pinky 真机网关（off 断开 / 无参看状态）
#   prompts          列出内置提示词库
#   red <c2|proxy|hephaestus>  部署型红队组件引导
set -eu

HZ_ROOT="${HZ_ROOT:-/opt/haizhu}"
OC_HOME="${OC_HOME:-/home/oc}"
PROFILES="${OC_PROFILES:-$OC_HOME/.oc-profiles}"
OC2_CFG="${OC2_CONFIG:-/root/.oc-opencode2/config/opencode}"
VERSION=$(cat "$HZ_ROOT/VERSION" 2>/dev/null || echo unknown)

die() { echo "hz: $*" >&2; exit 1; }

# ---- helpers ---------------------------------------------------------------
# seed 产物登记：每个目标根目录一份 .hz-manifest，remove 按单回收。
HZ_MANIFEST=""
hz_note() {
  [ -n "$HZ_MANIFEST" ] || return 0
  mkdir -p "$(dirname "$HZ_MANIFEST")"
  grep -qxF "F	$1" "$HZ_MANIFEST" 2>/dev/null || printf 'F\t%s\n' "$1" >> "$HZ_MANIFEST"
}
hz_note_link() {
  [ -n "$HZ_MANIFEST" ] || return 0
  mkdir -p "$(dirname "$HZ_MANIFEST")"
  grep -qxF "L	$1	$2" "$HZ_MANIFEST" 2>/dev/null || printf 'L\t%s\t%s\n' "$1" "$2" >> "$HZ_MANIFEST"
}
# 只在缺失或已是指向 HZ_ROOT 的链接时重建软链；外来真实文件/目录不动。
hz_link() {
  target="$1" link="$2"
  if [ -L "$link" ]; then
    case "$(readlink "$link")" in "$HZ_ROOT"/*) ;; *) return 0 ;; esac
  elif [ -e "$link" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$link")"
  ln -sfn "$target" "$link"
  hz_note_link "$link" "$target"
}
# 目录版：缺失 → 软链；已是目录 → 逐文件 write-if-absent 合并；其他 → 不动。
hz_dir() {
  src="$1" link="$2"
  if [ -L "$link" ]; then
    case "$(readlink "$link")" in "$HZ_ROOT"/*) ln -sfn "$src" "$link"; hz_note_link "$link" "$src" ;; esac
    return 0
  fi
  if [ -d "$link" ]; then
    (cd "$src" && find . -type f | while read -r f; do
      f="${f#./}"
      [ -e "$link/$f" ] || { mkdir -p "$link/$(dirname "$f")"; cp "$src/$f" "$link/$f"; hz_note "$link/$f"; }
    done)
    return 0
  fi
  [ -e "$link" ] && return 0
  mkdir -p "$(dirname "$link")"
  ln -sfn "$src" "$link"
  hz_note_link "$link" "$src"
}
# write-if-absent：仅当我们写出文件时登记。
hz_write_if_absent() {
  # $1 = 目标文件；stdin = 内容
  [ -e "$1" ] && { cat >/dev/null; return 0; }
  mkdir -p "$(dirname "$1")"
  cat > "$1"
  hz_note "$1"
}

# ---- seed ----------------------------------------------------------------
# 把内核/技能/角色/MCP 写进一个 HOME。幂等：软链重建，JSON 只在缺失时写。
seed_home() {
  H="$1"
  [ -d "$H" ] || mkdir -p "$H"
  HZ_MANIFEST="$H/.hz-manifest"
  # 通用标记文件（codex/agents.md 惯例 + claude CLAUDE.md）
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/AGENTS.md"
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/CLAUDE.md"
  mkdir -p "$H/.agents" && hz_dir "$HZ_ROOT/skills" "$H/.agents/skills"

  # Claude Code: CLAUDE_CONFIG_DIR=$H/claude
  mkdir -p "$H/claude"
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/claude/CLAUDE.md"
  hz_dir "$HZ_ROOT/skills" "$H/claude/skills"
  hz_dir "$HZ_ROOT/agents" "$H/claude/agents"
  hz_write_if_absent "$H/claude/.claude.json" <<'JSON'
{"mcpServers":{"filesystem":{"type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","{HOME}"],"env":{}},"sequential-thinking":{"type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-sequential-thinking"],"env":{}}}}
JSON

  # Codex: CODEX_HOME=$H/codex
  mkdir -p "$H/codex"
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/codex/AGENTS.md"
  hz_write_if_absent "$H/codex/config.toml" <<'TOML'
model_instructions_file = "/opt/haizhu/kernel/universal-kernel-v31.md"

[mcp_servers.sequential-thinking]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]

[mcp_servers.filesystem]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "{HOME}"]
TOML

  # Gemini / Qwen
  mkdir -p "$H/.gemini"
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/.gemini/GEMINI.md"
  mkdir -p "$H/.qwen"
  hz_link "$HZ_ROOT/kernel/universal-kernel-v31.md" "$H/.qwen/QWEN.md"

  # OpenCode（该 HOME 下手动跑 opencode 时）
  mkdir -p "$H/.config/opencode"
  hz_link "$HZ_ROOT/opencode/AGENTS.md" "$H/.config/opencode/AGENTS.md"
  hz_dir "$HZ_ROOT/agents" "$H/.config/opencode/agent"
  hz_dir "$HZ_ROOT/skills" "$H/.config/opencode/skill"
  [ -f "$H/.config/opencode/opencode.json" ] ||
    { sed 's|/root/projects|'"$H"'/projects|g' "$HZ_ROOT/opencode/opencode.json" \
      > "$H/.config/opencode/opencode.json" &&
      hz_note "$H/.config/opencode/opencode.json"; }

  # {HOME} 占位符替换（claude.json / config.toml 里）
  for f in "$H/claude/.claude.json" "$H/codex/config.toml" "$H/.config/opencode/opencode.json"; do
    [ -f "$f" ] && grep -q '{HOME}' "$f" 2>/dev/null &&
      sed -i "s|{HOME}|$H|g" "$f"
  done
  # root 身份跑 seed 时，把 oc 属下的产物交还 oc（agent 以 uid 1000 写配置）。
  if [ "$(id -u)" = 0 ]; then
    case "$H" in
      "$OC_HOME"|"$OC_HOME"/*)
        chown -R 1000:1000 "$H" 2>/dev/null || true ;;
    esac
  fi
  echo "hz: seeded $H"
}

# OpenCode 2 服务器（root 跑，XDG 隔离）专属 seed
seed_oc2() {
  mkdir -p "$OC2_CFG"
  HZ_MANIFEST="$OC2_CFG/.hz-manifest"
  hz_link "$HZ_ROOT/opencode/AGENTS.md" "$OC2_CFG/AGENTS.md"
  hz_dir "$HZ_ROOT/agents" "$OC2_CFG/agent"
  hz_dir "$HZ_ROOT/skills" "$OC2_CFG/skill"
  if [ ! -f "$OC2_CFG/opencode.json" ]; then
    cp "$HZ_ROOT/opencode/opencode.json" "$OC2_CFG/opencode.json"
    hz_note "$OC2_CFG/opencode.json"
  elif command -v node >/dev/null 2>&1; then
    OC2_CFG="$OC2_CFG" HZ_ROOT="$HZ_ROOT" node -e '
      const fs = require("fs");
      const p = process.env.OC2_CFG + "/opencode.json";
      const tpl = JSON.parse(fs.readFileSync(process.env.HZ_ROOT + "/opencode/opencode.json", "utf8"));
      let cur = {};
      try { cur = JSON.parse(fs.readFileSync(p, "utf8")); } catch (e) {}
      cur.instructions = [...new Set([...(cur.instructions || []), ...tpl.instructions])];
      cur.mcp = cur.mcp || {};
      cur.mcp.servers = { ...tpl.mcp.servers, ...(cur.mcp.servers || {}) };
      cur.agent = { ...tpl.agent, ...(cur.agent || {}) };
      fs.writeFileSync(p, JSON.stringify(cur, null, 2) + "\n");
    '
  fi
  echo "hz: seeded $OC2_CFG"
}

seed_all() {
  seed_oc2
  seed_home /root
  # oc 用户由 agent bootstrap 创建；未建时跳过，不抢先创建（root 属主会
  # 让 oc 写不进自己的 home）。之后由 PhoneAgentHaizhu 在 profile 启动时补齐。
  if [ -d "$OC_HOME" ]; then seed_home "$OC_HOME"; fi
  for h in "$PROFILES"/*/; do
    if [ -d "$h" ]; then seed_home "${h%/}"; fi
  done
}

# ---- remove -----------------------------------------------------------------
# 按 .hz-manifest 精确回收 seed 产物；用户自建/改过的路径不在单上。
hz_unseed_dir() {
  d="$1" m="$d/.hz-manifest"
  [ -f "$m" ] || return 0
  while IFS='	' read -r kind p target; do
    case "$kind" in
      F)
        case "$p" in "$d"/*) [ -L "$p" ] || [ -f "$p" ] && rm -f "$p" ;; esac ;;
      L)
        case "$p" in "$d"/*) ;; *) continue ;; esac
        if [ -L "$p" ] || [ -f "$p" ]; then
          rm -f "$p"
        elif [ -d "$p" ] && [ -d "$target" ]; then
          # 链接被换成了真实目录：只回收与 payload 源逐字节相同的文件，
          # 用户加进目录的东西原样保留。
          (cd "$p" && find . -type f | while read -r f; do
            f="${f#./}"
            [ -f "$target/$f" ] && cmp -s "$p/$f" "$target/$f" && rm -f "$p/$f"
          done)
        fi ;;
    esac
  done < "$m"
  rm -f "$m"
  # 先深度清理由我们腾空的子目录，再 rmdir 顶层——rmdir 只删空目录，
  # 残留用户文件的路径天然保留。
  for c in "$d/agent" "$d/skill" \
           "$d/.config/opencode/agent" "$d/.config/opencode/skill" \
           "$d/claude/agents" "$d/claude/skills" "$d/.agents/skills"; do
    [ -d "$c" ] && find "$c" -depth -type d -empty -delete 2>/dev/null || true
  done
  for c in "$d/agent" "$d/skill" "$d/commands" \
           "$d/.config/opencode" "$d/.config" "$d/claude" \
           "$d/codex" "$d/.gemini" "$d/.qwen" "$d/.agents"; do
    rmdir "$c" 2>/dev/null || true
  done
}
remove_all() {
  hz_unseed_dir "$OC2_CFG"
  hz_unseed_dir /root
  [ -d "$OC_HOME" ] && hz_unseed_dir "$OC_HOME"
  for h in "$PROFILES"/*/; do
    [ -d "$h" ] && hz_unseed_dir "${h%/}"
  done
  rm -f /usr/local/bin/hz
  # 只回收默认安装根；自定义 HZ_ROOT（开发树/测试根）绝不删。
  if [ "$HZ_ROOT" = /opt/haizhu ]; then
    rm -rf "$HZ_ROOT"
  else
    echo "hz: HZ_ROOT=$HZ_ROOT 非安装根，保留（unseed 已完成）" >&2
  fi
  echo "hz: removed"
}

# ---- status ---------------------------------------------------------------
status() {
  echo "haizhu $VERSION  root=$HZ_ROOT"
  for t in "$OC2_CFG/AGENTS.md" "$OC2_CFG/opencode.json" \
           "$OC_HOME/.agents/skills" "$OC_HOME/claude/CLAUDE.md" \
           /usr/local/bin/hz; do
    if [ -e "$t" ] || [ -L "$t" ]; then echo "  ok   $t"; else echo "  miss $t"; fi
  done
  n=$(find "$PROFILES" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  echo "  profiles: $n"
}

# ---- mcp ------------------------------------------------------------------
mcp_list() { cat "$HZ_ROOT/mcp/registry.json"; }
mcp_run() {
  id="$1"; shift || true
  case "$id" in
    rea) exec "$HZ_ROOT/vendor/rea/bridge/run.sh" "$@" ;;
    craft) exec craft mcp "$@" ;;
    pinky) die "pinky 是远程手机网关（hz phone <url> <token> 管理），不支持本地 run" ;;
    *) die "mcp run: unknown server '$id'" ;;
  esac
}
mcp_install() {
  id="$1"
  mkdir -p "$HZ_ROOT/vendor"
  case "$id" in
    rea)
      [ -d "$HZ_ROOT/vendor/rea/.git" ] ||
        git clone --depth 1 https://github.com/morluto/rea "$HZ_ROOT/vendor/rea"
      printf '#!/bin/sh\nexec node "%s/bridge/mcp.js" "$@"\n' "$HZ_ROOT/vendor/rea" \
        > "$HZ_ROOT/vendor/rea/bridge/run.sh" 2>/dev/null || true
      chmod +x "$HZ_ROOT/vendor/rea/bridge/run.sh" 2>/dev/null || true
      echo "hz: rea vendored — 完成其在 vendor/rea 内的安装步骤后，将 registry 中 rea.enabled 置 true 并 hz mcp sync"
      ;;
    craft)
      [ -d "$HZ_ROOT/vendor/craft/.git" ] ||
        git clone --depth 1 https://github.com/storytold/craft-anything "$HZ_ROOT/vendor/craft"
      echo "hz: craft vendored — 按 README 构建（cargo build --release）后，将 craft.enabled 置 true 并 hz mcp sync"
      ;;
    *) die "mcp install: unknown id '$id'" ;;
  esac
}
mcp_sync() {
  # 以 node 合并 registry 中 enabled=true 的项进各已存在配置（幂等）
  command -v node >/dev/null 2>&1 || die "mcp sync needs node"
  HZ_ROOT="$HZ_ROOT" node -e '
    const fs = require("fs"), path = require("path"), cp = require("child_process");
    const reg = JSON.parse(fs.readFileSync(process.env.HZ_ROOT + "/mcp/registry.json", "utf8"));
    const on = Object.entries(reg.servers).filter(([, s]) => s.enabled);
    const off = new Set(Object.entries(reg.servers).filter(([, s]) => !s.enabled).map(([id]) => id));
    const expand = (s, home) => s.replace(/\{HOME\}/g, home)
      .replace(/\{([A-Z_]+)\|([^}]*)\}/g, (_, k, d) => process.env[k] || d);
    const arr = (c, home) => c.map(x => expand(x, home));
    const headersOf = (s, home) => {
      const h = s.headers || {};
      const out = {};
      for (const [k, v] of Object.entries(h)) out[k] = expand(String(v), home);
      return Object.keys(out).length ? out : null;
    };
    const localEntry = (s, home) => s.transport === "stdio"
      ? { type: "local", command: arr(s.command, home), disabled: false }
      : { type: "remote", url: expand(s.url || "", home), enabled: true,
          ...(headersOf(s, home) ? { headers: headersOf(s, home) } : {}) };
    const stdioEntry = (s, home) => s.transport === "stdio"
      ? { type: "stdio", command: s.command[0], args: arr(s.command.slice(1), home), env: {} }
      : { type: "http", url: expand(s.url || "", home),
          ...(headersOf(s, home) ? { headers: headersOf(s, home) } : {}) };
    const targets = [];
    const oc2 = process.env.OC2_CONFIG || "/root/.oc-opencode2/config/opencode";
    if (fs.existsSync(oc2)) targets.push({ f: oc2 + "/opencode.json", k: "oc2", home: "/root" });
    const ocHome = process.env.OC_HOME || "/home/oc";
    const profDir = ocHome + "/.oc-profiles";
    const profiles = fs.existsSync(profDir)
      ? fs.readdirSync(profDir, { withFileTypes: true })
          .filter(d => d.isDirectory()).map(d => profDir + "/" + d.name)
      : [];
    const homes = [ocHome, "/root", ...profiles];
    for (const h of new Set(homes)) {
      const cj = h + "/claude/.claude.json";
      if (fs.existsSync(h + "/claude")) targets.push({ f: cj, k: "claude", home: h });
      const oc = h + "/.config/opencode/opencode.json";
      if (fs.existsSync(h + "/.config/opencode")) targets.push({ f: oc, k: "oc2", home: h });
      const ct = h + "/codex/config.toml";
      if (fs.existsSync(h + "/codex")) targets.push({ f: ct, k: "codex", home: h });
      const gm = h + "/.gemini/settings.json";
      if (fs.existsSync(h + "/.gemini")) targets.push({ f: gm, k: "gemini", home: h });
    }
    for (const t of targets) {
      if (t.k === "codex") continue;
      let j = {};
      try { j = JSON.parse(fs.readFileSync(t.f, "utf8")); } catch (e) {}
      if (t.k === "oc2") {
        j.mcp = j.mcp || {}; j.mcp.servers = j.mcp.servers || {};
        for (const [id, s] of on) j.mcp.servers[id] = localEntry(s, t.home);
        for (const id of off) delete j.mcp.servers[id];
      } else if (t.k === "claude" || t.k === "gemini") {
        j.mcpServers = j.mcpServers || {};
        for (const [id, s] of on) j.mcpServers[id] = stdioEntry(s, t.home);
        for (const id of off) delete j.mcpServers[id];
      }
      fs.writeFileSync(t.f, JSON.stringify(j, null, 2) + "\n");
      console.log("hz: synced", t.f);
    }
    // codex TOML：追加缺失段（简单幂等：已存在同名段则跳过）；registry 中 disabled 的段整体剔除
    for (const t of targets.filter(x => x.k === "codex")) {
      let toml = fs.existsSync(t.f) ? fs.readFileSync(t.f, "utf8") : "";
      for (const id of off) {
        toml = toml.replace(new RegExp("\\n*\\[mcp_servers\\." + id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\][^\\[]*", "g"), "");
      }
      for (const [id, s] of on) {
        if (toml.includes("[mcp_servers." + id + "]")) continue;
        if (s.transport === "stdio") {
          toml += `\n[mcp_servers.${id}]\ncommand = "${s.command[0]}"\nargs = [${s.command.slice(1).map(a => `"${expand(a, t.home)}"`).join(", ")}]\n`;
        } else {
          const hs = headersOf(s, t.home);
          const hh = hs
            ? `\nhttp_headers = { ${Object.entries(hs).map(([k, v]) => `"${k}" = "${v}"`).join(", ")} }`
            : "";
          toml += `\n[mcp_servers.${id}]\nurl = "${expand(s.url || "", t.home)}"${hh}\n`;
        }
      }
      fs.writeFileSync(t.f, toml);
      console.log("hz: synced", t.f);
    }
  '
}
phone() {
  # hz phone <url> [token]  配对 Pinky 网关（PC 端 Settings > Remote agents）
  # hz phone off            断开（禁用 pinky MCP 并重新同步）
  # hz phone                查看当前配对状态
  case "${1:-}" in
    ""|status)
      node -e '
        const fs = require("fs"), r = JSON.parse(fs.readFileSync(process.env.HZ_ROOT + "/mcp/registry.json", "utf8"));
        const s = (r.servers || {}).pinky || {};
        console.log(JSON.stringify({ enabled: !!s.enabled, url: s.url || null,
          hasToken: !!(s.headers && !String(s.headers.Authorization || "").endsWith("|}") && !String(s.headers.Authorization || "").endsWith("Bearer }")) }, null, 2));
      ' || die "phone status needs node"
      ;;
    off)
      command -v node >/dev/null 2>&1 || die "phone off needs node"
      HZ_ROOT="$HZ_ROOT" node -e '
        const fs = require("fs"), p = process.env.HZ_ROOT + "/mcp/registry.json";
        const r = JSON.parse(fs.readFileSync(p, "utf8"));
        if (!r.servers.pinky) { console.error("hz: no pinky entry"); process.exit(1); }
        r.servers.pinky.enabled = false;
        fs.writeFileSync(p, JSON.stringify(r, null, 2) + "\n");
        console.log("hz: pinky -> false");
      '
      mcp_sync ;;
    *://*)
      url="$1"; token="${2:-}"
      command -v node >/dev/null 2>&1 || die "phone needs node"
      HZ_ROOT="$HZ_ROOT" HZ_URL="$url" HZ_TOKEN="$token" node -e '
        const fs = require("fs"), p = process.env.HZ_ROOT + "/mcp/registry.json";
        const r = JSON.parse(fs.readFileSync(p, "utf8"));
        const s = r.servers.pinky || (r.servers.pinky = { title: "Pinky 真机手机操控", transport: "http" });
        s.url = process.env.HZ_URL;
        if (process.env.HZ_TOKEN) s.headers = { Authorization: "Bearer " + process.env.HZ_TOKEN };
        s.enabled = true;
        fs.writeFileSync(p, JSON.stringify(r, null, 2) + "\n");
        console.log("hz: pinky ->", process.env.HZ_URL);
      '
      mcp_sync
      echo "hz: pinky 已启用——agent 通过 phone_* MCP 工具操作手机；高危操作由 Pinky 网关人工审批" ;;
    *) die "phone: <url> [token] | off | status" ;;
  esac
}

mcp_doctor() {
  for c in node npx python3 pip3 git; do
    printf '%-6s %s\n' "$c" "$(command -v "$c" 2>/dev/null || echo MISSING)"
  done
  status
}

# ---- red -------------------------------------------------------------------
red() {
  case "${1:-}" in
    c2) cat <<'TXT'
[github-C2 部署引导] 授权实验室专用
1) git clone --depth 1 https://github.com/Kxiandaoyan/github-C2 /opt/haizhu/vendor/github-c2
2) 编辑 c2/worker 配置（Cloudflare 账号 + D1），bash deploy.sh 起 Worker 主通道
3) 控制台：python3 c2/console/app.py（Flask，127.0.0.1）
4) Agent：rust 编译 c2/agent 或用 release 包，载荷 AES-256-GCM 信封，
   主通道断自动切 GitHub Issue 备用通道
5) 接入 AI：控制台暴露 MCP 接口，将本工具加入 registry transport=http
TXT
      ;;
    proxy) cat <<'TXT'
[ProxyCat 部署引导]
1) git clone --depth 1 https://github.com/honmashironeko/ProxyCat /opt/haizhu/vendor/proxycat
2) config/config.ini 填静态代理列表（ip:port 每行一个）
3) docker compose up -d  或  python3 ProxyCat.py -p 1080
4) 固定入口 socks5://127.0.0.1:1080 自动轮转出口 IP；API 见 API.md
TXT
      ;;
    hephaestus) cat <<'TXT'
[Hephaestus-Agent 部署引导]
1) curl -fsSL https://raw.githubusercontent.com/qiwentaidi/Hephaestus-Agent/main/scripts/install.sh -o install.sh
2) bash install.sh --server 'https://<主服务>' —— 交互配置 PostgreSQL 与节点角色（扫描/AI Worker）
3) 运行：bash ./hephaestus-agent/run.sh；平台侧「Agent 管理」做托管更新
TXT
      ;;
    *) die "red: c2|proxy|hephaestus" ;;
  esac
}

# ---- provider --------------------------------------------------------------
# 自定义 provider 写进 OC2 的 opencode.json（与 App 的 experimental/fs/write
# 同一数据面——PATCH /experimental/config 只收 {shell}）。key 只进配置文件，
# 不回显；remove 直接删键。
OC2_JSON="${OC2_CONFIG:-/root/.oc-opencode2/config/opencode}/opencode.json"
provider_list() {
  [ -f "$OC2_JSON" ] || die "no $OC2_JSON (seed first)"
  command -v node >/dev/null 2>&1 || die "provider needs node"
  HZ_JSON="$OC2_JSON" node -e '
    const fs = require("fs");
    const j = JSON.parse(fs.readFileSync(process.env.HZ_JSON, "utf8"));
    const p = j.provider || {};
    const ids = Object.keys(p);
    if (!ids.length) { console.log("(no custom providers)"); process.exit(0); }
    for (const id of ids) {
      const v = p[id] || {}, o = v.options || {};
      const models = Object.keys(v.models || {}).join(", ");
      console.log(`${id}\t${o.baseURL || "-"}\t${v.name || "-"}\tmodels: ${models || "-"}`);
    }
  '
}
# provider add <id> <baseURL> <model...> [--name N] [--key K] [--npm P] [--default]
provider_add() {
  [ $# -ge 3 ] || die "provider add <id> <baseURL> <model...> [--name N] [--key K] [--npm P] [--default]"
  command -v node >/dev/null 2>&1 || die "provider needs node"
  local id="$1" url="$2"; shift 2
  local name="" key="" npm="@ai-sdk/openai-compatible" def="" models=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      --npm) npm="$2"; shift 2 ;;
      --default) def="1"; shift ;;
      *) models="$models $1"; shift ;;
    esac
  done
  [ -n "$models" ] || die "provider add: at least one model id"
  [ -d "${OC2_JSON%/*}" ] || mkdir -p "${OC2_JSON%/*}"
  HZ_JSON="$OC2_JSON" HZ_ID="$id" HZ_URL="$url" HZ_NAME="$name" HZ_KEY="$key" \
    HZ_NPM="$npm" HZ_MODELS="$models" HZ_DEF="$def" node -e '
    const fs = require("fs"), e = process.env;
    const f = e.HZ_JSON;
    let j = {};
    try { j = JSON.parse(fs.readFileSync(f, "utf8")); } catch (x) {}
    const models = e.HZ_MODELS.trim().split(/\s+/);
    const entry = {
      npm: e.HZ_NPM,
      options: {
        baseURL: e.HZ_URL,
        apiKey: e.HZ_KEY.trim() === "" ? "none" : e.HZ_KEY.trim(),
      },
      models: Object.fromEntries(models.map(m => [m, {}])),
    };
    if (e.HZ_NAME.trim() !== "") entry.name = e.HZ_NAME.trim();
    j.provider = j.provider || {};
    j.provider[e.HZ_ID] = entry;
    if (e.HZ_DEF === "1") j.model = `${e.HZ_ID}/${models[0]}`;
    fs.writeFileSync(f, JSON.stringify(j, null, 2) + "\n");
    console.log("hz: provider", e.HZ_ID, "->", f);
    if (e.HZ_DEF === "1") console.log("hz: default model ->", j.model);
    console.log("hz: restart the OpenCode instance to load it");
  '
}
provider_remove() {
  local id="${1:?provider remove <id>}"
  command -v node >/dev/null 2>&1 || die "provider needs node"
  [ -f "$OC2_JSON" ] || die "no $OC2_JSON"
  HZ_JSON="$OC2_JSON" HZ_ID="$id" node -e '
    const fs = require("fs"), e = process.env;
    const f = e.HZ_JSON;
    const j = JSON.parse(fs.readFileSync(f, "utf8"));
    if (!j.provider || !(e.HZ_ID in j.provider)) { console.error("hz: no such provider"); process.exit(1); }
    delete j.provider[e.HZ_ID];
    if (typeof j.model === "string" && j.model.startsWith(e.HZ_ID + "/")) delete j.model;
    fs.writeFileSync(f, JSON.stringify(j, null, 2) + "\n");
    console.log("hz: provider", e.HZ_ID, "removed");
  '
}

# ---- assistant --------------------------------------------------------------
# assistant 预设写进 OC2 的 opencode.json `agent.<id>`（与 App 的
# experimental/fs/write 同一数据面；RikkaHub 式的人格包：指令+模型+采样参数）。
assistant_list() {
  [ -f "$OC2_JSON" ] || die "no $OC2_JSON (seed first)"
  command -v node >/dev/null 2>&1 || die "assistant needs node"
  HZ_JSON="$OC2_JSON" node -e '
    const fs = require("fs");
    const j = JSON.parse(fs.readFileSync(process.env.HZ_JSON, "utf8"));
    const a = j.agent || {};
    const ids = Object.keys(a);
    if (!ids.length) { console.log("(no config assistants)"); process.exit(0); }
    for (const id of ids) {
      const v = a[id] || {};
      console.log(`${id}\t${v.mode || "-"}\t${v.model || "-"}\t${(v.description || "").slice(0, 60)}`);
    }
  '
}
# assistant add <id> --prompt TEXT | --prompt-file PATH [--desc D]
#   [--mode primary|subagent|all] [--model provider/model]
#   [--temp 0-2] [--top-p 0-1] [--color #rrggbb] [--disable]
assistant_add() {
  local id="${1:?assistant add <id> --prompt ...}"; shift || true
  command -v node >/dev/null 2>&1 || die "assistant needs node"
  local desc="" mode="" model="" temp="" topp="" color="" dis="" prompt="" pfile=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prompt) prompt="$2"; shift 2 ;;
      --prompt-file) pfile="$2"; shift 2 ;;
      --desc) desc="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --temp) temp="$2"; shift 2 ;;
      --top-p) topp="$2"; shift 2 ;;
      --color) color="$2"; shift 2 ;;
      --disable) dis="1"; shift ;;
      *) die "assistant add: unknown option $1" ;;
    esac
  done
  if [ -n "$pfile" ]; then
    [ -f "$pfile" ] || die "no prompt file $pfile"
    prompt="$(cat "$pfile")"
  fi
  [ -n "$prompt" ] || die "assistant add: --prompt or --prompt-file required"
  [ -d "${OC2_JSON%/*}" ] || mkdir -p "${OC2_JSON%/*}"
  HZ_JSON="$OC2_JSON" HZ_ID="$id" HZ_DESC="$desc" HZ_MODE="$mode" \
    HZ_MODEL="$model" HZ_TEMP="$temp" HZ_TOPP="$topp" HZ_COLOR="$color" \
    HZ_DIS="$dis" HZ_PROMPT="$prompt" node -e '
    const fs = require("fs"), e = process.env;
    const f = e.HZ_JSON;
    let j = {};
    try { j = JSON.parse(fs.readFileSync(f, "utf8")); } catch (x) {}
    if (!/^[a-z0-9][a-z0-9-_]{0,62}$/.test(e.HZ_ID)) {
      console.error("hz: bad assistant id"); process.exit(1);
    }
    if (e.HZ_MODE && !["primary","subagent","all"].includes(e.HZ_MODE)) {
      console.error("hz: bad mode"); process.exit(1);
    }
    const t = e.HZ_TEMP === "" ? null : Number(e.HZ_TEMP);
    if (t !== null && !(t >= 0 && t <= 2)) { console.error("hz: temp 0-2"); process.exit(1); }
    const p = e.HZ_TOPP === "" ? null : Number(e.HZ_TOPP);
    if (p !== null && !(p > 0 && p <= 1)) { console.error("hz: top-p (0,1]"); process.exit(1); }
    if (e.HZ_COLOR && !/^#[0-9a-fA-F]{6}$/.test(e.HZ_COLOR)) {
      console.error("hz: color #rrggbb"); process.exit(1);
    }
    if (e.HZ_MODEL && !e.HZ_MODEL.includes("/")) {
      console.error("hz: model must look like provider/model"); process.exit(1);
    }
    const entry = { mode: e.HZ_MODE || "primary", prompt: e.HZ_PROMPT };
    if (e.HZ_DESC.trim() !== "") entry.description = e.HZ_DESC.trim();
    if (e.HZ_MODEL) entry.model = e.HZ_MODEL;
    if (t !== null) entry.temperature = t;
    if (p !== null) entry.top_p = p;
    if (e.HZ_COLOR) entry.color = e.HZ_COLOR;
    if (e.HZ_DIS === "1") entry.disable = true;
    j.agent = j.agent || {};
    j.agent[e.HZ_ID] = entry;
    fs.writeFileSync(f, JSON.stringify(j, null, 2) + "\n");
    console.log("hz: assistant", e.HZ_ID, "->", f);
    console.log("hz: restart the OpenCode instance to load it");
  '
}
assistant_remove() {
  local id="${1:?assistant remove <id>}"
  command -v node >/dev/null 2>&1 || die "assistant needs node"
  [ -f "$OC2_JSON" ] || die "no $OC2_JSON"
  HZ_JSON="$OC2_JSON" HZ_ID="$id" node -e '
    const fs = require("fs"), e = process.env;
    const f = e.HZ_JSON;
    const j = JSON.parse(fs.readFileSync(f, "utf8"));
    if (!j.agent || !(e.HZ_ID in j.agent)) { console.error("hz: no such assistant"); process.exit(1); }
    delete j.agent[e.HZ_ID];
    fs.writeFileSync(f, JSON.stringify(j, null, 2) + "\n");
    console.log("hz: assistant", e.HZ_ID, "removed");
  '
}

verb="${1:-help}"; shift || true
case "$verb" in
  seed) [ $# -gt 0 ] && { for h in "$@"; do seed_home "$h"; done; seed_oc2; } || seed_all ;;
  seed-all) seed_all ;;
  remove|unseed) remove_all ;;
  status) status ;;
  kernel) echo "$HZ_ROOT/kernel/universal-kernel-v31.md" ;;
  agents) ls "$HZ_ROOT/agents" ;;
  skills) ls "$HZ_ROOT/skills" ;;
  prompts) ls "$HZ_ROOT/prompts/builtin" ;;
  mcp)
    case "${1:-list}" in
      list) shift || true; mcp_list "$@" ;;
      run) shift; mcp_run "$@" ;;
      install) shift; mcp_install "$@" ;;
      enable|disable)
        id="$2"
        want=$([ "$1" = enable ] && echo true || echo false)
        command -v node >/dev/null 2>&1 || die "mcp $1 needs node"
        HZ_ROOT="$HZ_ROOT" HZ_ID="$id" HZ_WANT="$want" node -e '
          const fs = require("fs"), p = process.env.HZ_ROOT + "/mcp/registry.json";
          const r = JSON.parse(fs.readFileSync(p, "utf8"));
          if (!r.servers[process.env.HZ_ID]) { console.error("hz: no such server"); process.exit(1); }
          r.servers[process.env.HZ_ID].enabled = process.env.HZ_WANT === "true";
          fs.writeFileSync(p, JSON.stringify(r, null, 2) + "\n");
          console.log("hz:", process.env.HZ_ID, "->", process.env.HZ_WANT);
        '
        mcp_sync ;;
      sync) mcp_sync ;;
      doctor) mcp_doctor ;;
      *) die "mcp: list|run|install|enable|disable|sync|doctor" ;;
    esac ;;
  red) red "$@" ;;
  phone) phone "$@" ;;
  provider)
    case "${1:-list}" in
      list) provider_list ;;
      add) shift; provider_add "$@" ;;
      remove|rm) shift; provider_remove "$@" ;;
      *) die "provider: list|add|remove" ;;
    esac ;;
  assistant)
    case "${1:-list}" in
      list) assistant_list ;;
      add) shift; assistant_add "$@" ;;
      remove|rm) shift; assistant_remove "$@" ;;
      *) die "assistant: list|add|remove" ;;
    esac ;;
  version|*) echo "haizhu $VERSION — hz seed|status|kernel|agents|skills|prompts|mcp|phone|provider|assistant|red" ;;
esac
